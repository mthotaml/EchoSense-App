{
  "version": 2,
  "release_gate": {
    "required_checks": [
      "configuration",
      "ruff",
      "contract-tests",
      "spotify-reference-journey",
      "application-profile-smoke",
      "release-evidence"
    ]
  },
  "invariants": [
    {
      "id": "frontend-failure-safety",
      "severity": "severity-1",
      "description": "Unsuccessful API responses render a bounded product message without an uncaught JavaScript failure.",
      "covers": ["spotify-data-failure-rendered", "playlist-outage-isolated"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "Guardian safely renders Spotify ${status} failures"
        },
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "Guardian isolates a Spotify playlist outage from core listening"
        }
      ]
    },
    {
      "id": "audible-browser-playback",
      "severity": "severity-1",
      "description": "Playback success requires an activated browser player and observed unpaused SDK state.",
      "covers": ["browser-audio-user-gesture-activated", "browser-audio-playing-verified", "silent-playback-not-reported-success"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "__activateElementCalls"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "waitForAudibleBrowserPlayback"
        }
      ]
    },
    {
      "id": "player-asset-contract",
      "severity": "severity-1",
      "description": "The page and player lifecycle asset are version aligned and stale assets are not cached.",
      "covers": ["player-lifecycle-asset-versioned", "player-ready"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "cache-control"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "PLAYER_LIFECYCLE_VERSION"
        }
      ]
    },
    {
      "id": "playback-identity-attribution",
      "severity": "severity-1",
      "description": "Feedback is attributed to the actively playing decision, never merely the displayed next recommendation.",
      "covers": ["current-and-next-identities-separated", "playback-feedback-decision-bound", "autopilot-current-decision-stable"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "activePlaybackDecisionId"
        },
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "decision_id"
        }
      ]
    },
    {
      "id": "verified-skip",
      "severity": "severity-1",
      "description": "Skip selects the next ranked Music DNA decision directly and succeeds only after that exact track is observed playing; Spotify's generic next-track ordering must never drive this transition.",
      "covers": ["skip-transition-verified", "skip-noop-not-reported-success", "skip-active-device-targeted", "skip-next-dna-decision-bound", "skip-provider-next-bypassed"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "Spotify did not start the selected Music DNA track"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "nextDna=orderedCandidates.find"
        }
      ]
    },
    {
      "id": "verified-completion-transition",
      "severity": "severity-1",
      "description": "Natural track completion explicitly starts the next ranked Music DNA decision; Spotify's provider queue must not choose the next track.",
      "covers": ["completion-transition-verified", "completion-next-dna-decision-bound", "completion-provider-next-bypassed"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "dna-completion-play"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "completionTransitionInFlight"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "sameTrackFinished"
        }
      ]
    },
    {
      "id": "continuous-diverse-autopilot",
      "severity": "severity-2",
      "description": "Autopilot presents paginated rounds of six distinct tracks and generates a fresh excluded round after a hero skip or completion of all six tracks.",
      "covers": ["autopilot-six-track-round", "autopilot-hero-skip-new-round", "autopilot-completed-round-rollover", "autopilot-round-pagination", "autopilot-manual-add-absent", "autopilot-candidate-exclusions-honored"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "DNA_ROUND_SIZE = 6"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "generateNextDnaRound('completed')"
        },
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "roundsBeforeSkip + 1"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "queue-add"
        }
      ]
    },
    {
      "id": "provider-outage-isolation",
      "severity": "severity-2",
      "description": "Transient Spotify failures do not collapse the core listening experience.",
      "covers": ["playlist-outage-isolated", "weather-fallback-preserves-ranking"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "spotify_library_failed"
        },
        {
          "source": "tests/test_context_fusion.py",
          "pattern": "weather"
        }
      ]
    },
    {
      "id": "ranking-factor-explainability",
      "severity": "severity-2",
      "description": "Every Music DNA ranking factor is explained in plain language without cluttering each track row.",
      "covers": [
        "dna-factor-comparison-table",
        "dna-factor-definitions-accessible",
        "normalized-match-score-derived"
      ],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "factorExplanations"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "info.setAttribute('aria-label'"
        },
        {
          "source": "tests/test_playback_learning.py",
          "pattern": "test_normalized_score_maps_theoretical_bounds_to_zero_and_one_hundred"
        },
        {
          "source": "tests/test_spotify_auth.py",
          "pattern": "why_now"
        }
      ]
    }
  ],
