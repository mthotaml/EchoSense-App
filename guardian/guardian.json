{
  "version": 2,
  "release_gate": {
    "required_checks": [
      "configuration",
      "ruff",
      "contract-tests",
      "spotify-reference-journey",
      "application-profile-smoke",
      "release-evidence"
    ]
  },
  "invariants": [
    {
      "id": "frontend-failure-safety",
      "severity": "severity-1",
      "description": "Unsuccessful API responses render a bounded product message without an uncaught JavaScript failure.",
      "covers": ["spotify-data-failure-rendered", "playlist-outage-isolated"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "Guardian safely renders Spotify ${status} failures"
        },
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "Guardian isolates a Spotify playlist outage from core listening"
        }
      ]
    },
    {
      "id": "oauth-rate-limit-backoff",
      "severity": "severity-1",
      "description": "Spotify connection profile loading respects Retry-After, retries once without a tight loop, and returns a bounded rate-limit response if Spotify remains unavailable.",
      "covers": ["oauth-profile-rate-limit-retried", "oauth-rate-limit-bounded", "oauth-tight-retry-prohibited"],
      "evidence": [
        {
          "source": "tests/test_spotify_auth.py",
          "pattern": "test_spotify_profile_retries_once_after_retry_after"
        },
        {
          "source": "tests/test_spotify_auth.py",
          "pattern": "test_spotify_profile_returns_bounded_rate_limit_error_after_retry"
        }
      ]
    },
    {
      "id": "audible-browser-playback",
      "severity": "severity-1",
      "description": "Playback success requires an activated browser player and observed unpaused SDK state.",
      "covers": ["browser-audio-user-gesture-activated", "browser-audio-playing-verified", "silent-playback-not-reported-success"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "__activateElementCalls"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "waitForAudibleBrowserPlayback"
        }
      ]
    },
    {
      "id": "player-asset-contract",
      "severity": "severity-1",
      "description": "The page and player lifecycle asset are version aligned and stale assets are not cached.",
      "covers": ["player-lifecycle-asset-versioned", "player-ready"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "cache-control"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "PLAYER_LIFECYCLE_VERSION"
        }
      ]
    },
    {
      "id": "playback-identity-attribution",
      "severity": "severity-1",
      "description": "Feedback is attributed to the actively playing decision, never merely the displayed next recommendation.",
      "covers": ["current-and-next-identities-separated", "playback-feedback-decision-bound", "autopilot-current-decision-stable"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "activePlaybackDecisionId"
        },
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "decision_id"
        }
      ]
    },
    {
      "id": "verified-skip",
      "severity": "severity-1",
      "description": "Skip selects the next EchoSense recommendation directly and succeeds only after that exact track is observed playing; Spotify's generic next-track ordering must never drive this transition.",
      "covers": ["skip-transition-verified", "skip-noop-not-reported-success", "skip-active-device-targeted", "skip-next-dna-decision-bound", "skip-provider-next-bypassed"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "Spotify did not start the selected EchoSense recommendation"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "nextDna=orderedCandidates.find"
        }
      ]
    },
    {
      "id": "provider-autoplay-overridden",
      "severity": "severity-1",
      "description": "If Spotify advances to a track outside the active EchoSense Playback Plan, EchoSense detects the drift and explicitly restores the expected recommendation instead of adopting the provider queue.",
      "covers": ["observed-track-plan-verified", "provider-autoplay-not-authoritative", "expected-recommendation-restored"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "provider-autoplay-overridden"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "playbackPlanReconciliationInFlight"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "Spotify advanced outside the EchoSense Playback Plan"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "await playDnaTrack(expected)"
        }
      ]
    },
    {
      "id": "verified-completion-transition",
      "severity": "severity-1",
      "description": "Natural track completion explicitly starts the next recommendation in the EchoSense Playback Plan; Spotify's provider queue must not choose the next track.",
      "covers": ["completion-transition-verified", "completion-next-dna-decision-bound", "completion-provider-next-bypassed"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "dna-completion-play"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "completionTransitionInFlight"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "sameTrackFinished"
        }
      ]
    },
    {
      "id": "dna-sequence-playback-ownership",
      "severity": "severity-1",
      "description": "Starting or skipping to an EchoSense recommendation disables shuffle and repeat, installs the remaining ranked playback plan as one ordered Spotify sequence, and never appends planned tracks through Spotify's provider queue.",
      "covers": ["dna-sequence-ordered", "dna-final-plan-visible", "dna-plan-context-visible", "dna-continuation-decision-owned", "provider-queue-not-authoritative", "provider-queue-duplicates-collapsed", "playback-sequence-source-visible", "dna-shuffle-disabled", "dna-repeat-disabled", "autopilot-provider-queue-write-prohibited"],
      "evidence": [
        {
          "source": "tests/test_player_routes.py",
          "pattern": "test_context_playback_installs_owned_dna_sequence_in_order"
        },
        {
          "source": "tests/test_player_routes.py",
          "pattern": "test_context_playback_rejects_unowned_dna_sequence"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "continuation_decision_ids"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "EchoSense controls playback"
        },
        {
          "source": "tests/test_player_routes.py",
          "pattern": "playback_mode"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "test_playback_verification_prefers_owned_dna_and_collapses_provider_duplicates"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "test_final_playback_plan_names_the_exact_ranked_dna_sequence"
        }
      ]
    },
    {
      "id": "continuous-diverse-autopilot",
      "severity": "severity-2",
      "description": "Autopilot presents paginated rounds of six distinct tracks and generates a fresh excluded round after a hero skip or completion of all six tracks.",
      "covers": ["autopilot-six-track-round", "autopilot-hero-skip-new-round", "autopilot-completed-round-rollover", "autopilot-round-pagination", "autopilot-manual-add-absent", "autopilot-candidate-exclusions-honored"],
      "evidence": [
        {
          "source": "tests/test_product_ui.py",
          "pattern": "DNA_ROUND_SIZE = 6"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "generateNextDnaRound('completed')"
        },
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "roundsBeforeSkip + 1"
        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "queue-add"
        }
      ]
    },
    {
      "id": "provider-outage-isolation",
      "severity": "severity-2",
      "description": "Transient Spotify failures do not collapse the core listening experience.",
      "covers": ["playlist-outage-isolated", "weather-fallback-preserves-ranking"],
      "evidence": [
        {
          "source": "tests/e2e/spotify-reference.spec.js",
          "pattern": "spotify_library_failed"
