        {
          "source": "tests/test_playback_learning.py",
          "pattern": "test_normalized_score_maps_theoretical_bounds_to_zero_and_one_hundred"
        },
        {
          "source": "tests/test_spotify_auth.py",
          "pattern": "why_now"
        }
      ]
    },
    {
      "id": "explainable-product-surface",
      "severity": "severity-2",
      "description": "The product surface keeps recommendation evidence, memory provenance, and governance controls visible while never claiming unsupported deletion or retention enforcement.",
      "covers": [
        "hero-factor-breakdown",
        "memory-inspector-visible",
        "governance-deletion-locked-without-receipt-api",
        "single-player-persistent"
