        },
        {
          "source": "tests/test_product_ui.py",
          "pattern": "test_recommendation_boosters_drive_every_spotify_recommendation_request"
        },
        {
          "source": "tests/test_spotify_auth.py",
          "pattern": "boost_live_context=80&boost_diversity=100"
        }
      ]
    }
