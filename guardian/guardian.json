          "source": "tests/test_product_ui.py",
          "pattern": "receipt-generating governance endpoint"
        }
      ]
    },
    {
      "id": "recommendation-boost-truthfulness",
      "severity": "severity-1",
      "description": "User boosts are bounded and normalized, alter the same ranking decision that drives Autopilot, and the displayed context statement reports those exact inputs and effective weights.",
      "covers": [
        "recommendation-boosts-bounded",
        "recommendation-boosts-normalized",
        "diversity-boost-reranks",
