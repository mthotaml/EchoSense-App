{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "release_gate", "invariants", "journeys"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "release_gate": {
      "type": "object",
      "required": ["required_checks"],
      "properties": {
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "covers", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "severity": {"enum": ["severity-1", "severity-2", "severity-3"]},
          "description": {"type": "string", "minLength": 1},
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "pattern"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "pattern": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "spec", "states"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "spec": {"type": "string", "minLength": 1},
          "states": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "planned_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
