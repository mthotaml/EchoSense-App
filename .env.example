# EchoSense runtime
ECHOSENSE_MUSIC_PROVIDER=apple_music
ECHOSENSE_DATABASE_URL=sqlite:///./echosense.db

# Spotify safety controls. These are conservative application ceilings, not Spotify quotas.
ECHOSENSE_SPOTIFY_REQUEST_BUDGET=20
ECHOSENSE_SPOTIFY_TIMEOUT_SECONDS=8

# Apple Music developer credentials
# Find Team ID under Apple Developer account > Membership.
APPLE_MUSIC_TEAM_ID=YOUR_10_CHARACTER_TEAM_ID
APPLE_MUSIC_KEY_ID=YOUR_10_CHARACTER_KEY_ID

# Store the downloaded MusicKit .p8 key outside source control and point to it here.
APPLE_MUSIC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Optional: developer-token lifetime in seconds. Default is 12 hours.
# Apple permits at most 15777000 seconds (approximately six months).
APPLE_MUSIC_TOKEN_TTL_SECONDS=43200

# Apple Music storefront used for catalog search.
APPLE_MUSIC_STOREFRONT=us

# Required to encrypt Apple Music and Spotify credentials before database persistence.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECHOSENSE_TOKEN_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Optional key rotation: comma-separated Fernet keys, newest first.
# When set, this takes precedence over ECHOSENSE_TOKEN_ENCRYPTION_KEY.
# ECHOSENSE_TOKEN_ENCRYPTION_KEYS=NEW_KEY_HERE,PREVIOUS_KEY_HERE
